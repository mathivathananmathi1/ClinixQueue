<Window x:Class="ClinixQueue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinixQueue - Doctor Patient Token Queue" Height="750" Width="850"
        WindowStartupLocation="CenterScreen" Background="#120B23">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Background="#1E1338" Padding="20,15" BorderBrush="#2D1B54" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="ClinixQueue" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Doctor Patient Token Queue System" Foreground="#A78BFA" FontSize="12"/>
                </StackPanel>
                <Border Background="#7C3AED" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,5">
                    <TextBlock Text="Reception" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Top Statistics Cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Waiting Card -->
                    <Border Grid.Column="0" Background="#1A103C" CornerRadius="12" Padding="20" BorderBrush="#2D1B54" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="👥 Waiting Patients" Foreground="#A78BFA" FontSize="13" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtWaitingCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Current Token Card -->
                    <Border Grid.Column="2" Background="#1A103C" CornerRadius="12" Padding="20" BorderBrush="#2D1B54" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🎟 Current Token" Foreground="#A78BFA" FontSize="13" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtCurrentToken" Text="--" FontSize="36" FontWeight="Bold" Foreground="#C084FC" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Now Consulting Section -->
                <Border Background="#1A103C" CornerRadius="12" Padding="24" Margin="0,0,0,16" BorderBrush="#2D1B54" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="NOW CONSULTING" Foreground="#A78BFA" FontSize="12" FontWeight="Bold"/>

                        <!-- Patient Info & Status -->
                        <Grid Margin="0,16,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar Placeholder -->
                            <Border Grid.Column="0" Width="56" Height="56" Background="#2E1A47" CornerRadius="28" Margin="0,0,16,0">
                                <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Name and Token -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCurrentPatientName" Text="No active consultation" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtCurrentPatientToken" Text="Patient Token #---" FontSize="14" Foreground="#A78BFA" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border x:Name="BorderConsultingStatus" Grid.Column="2" Background="#2A1B3D" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtConsultingStatus" Text="Waiting to Start" Foreground="#C084FC" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                        </Grid>

                        <!-- Doctor Arrival Banner -->
                        <Border Background="#162323" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#1E3A3A" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✔" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtDoctorStatus" Text="Doctor has arrived" Foreground="#6EE7B7" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnNextPatient" Grid.Column="0" Content="➔ Next Patient" Click="BtnNextPatient_Click" 
                                    Background="#7C3AED" Foreground="White" FontWeight="SemiBold" Height="48" BorderThickness="0" Cursor="Hand"/>

                            <Button x:Name="BtnFinishVisit" Grid.Column="2" Content="✔ Finish Visit" Click="BtnFinishVisit_Click" 
                                    Background="#2E1A47" Foreground="#E9D5FF" FontWeight="SemiBold" Height="48" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Register Patient Section -->
                <Border Background="#1A103C" CornerRadius="12" Padding="24" BorderBrush="#2D1B54" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Register Patient" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="Patient name" FontSize="13" Foreground="#C4B5FD" Margin="0,0,0,6"/>

                        <TextBox x:Name="TxtPatientNameInput" Height="44" Padding="12,10" FontSize="14" 
                                 Background="#120B23" Foreground="White" BorderBrush="#3B2667" BorderThickness="1" 
                                 VerticalContentAlignment="Center" KeyDown="TxtPatientNameInput_KeyDown"/>

                        <Button Content="⊕ Create Token" Click="BtnCreateToken_Click" 
                                Background="#7C3AED" Foreground="White" FontWeight="SemiBold" 
                                Height="48" Margin="0,16,0,0" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>